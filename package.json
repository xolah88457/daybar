{
  "name": "daybar", "version": "0.3.1", "private": true,
  "packageManager": "pnpm@10.12.3",
  "scripts": {
    "dev": "pnpm --filter @daybar/desktop dev",
    "build": "pnpm --filter @daybar/desktop build",
    "tauri": "pnpm --filter @daybar/desktop tauri",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test && pnpm test:phone",
    "test:phone": "node --test scriptable/tests/*.test.mjs",
    "test:tz": "TZ=America/Toronto pnpm test && TZ=Europe/London pnpm test",
    "lint": "eslint .",
    "test:rust": "cargo test --manifest-path apps/desktop/src-tauri/Cargo.toml",
    "seed": "node scripts/seed-sandbox.mjs",
    "schemas": "node --experimental-strip-types packages/core/scripts/generate-schemas.mjs"
  },
  "devDependencies": { "typescript": "^5.9.3", "vitest": "^4.0.0", "eslint": "^9.39.0", "typescript-eslint": "^8.46.0", "@eslint/js": "^9.39.0", "@types/node": "^24.10.0" }
}
