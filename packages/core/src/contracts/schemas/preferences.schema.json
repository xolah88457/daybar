{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "dataFolder": {
      "type": "string"
    },
    "realData": {
      "type": "boolean"
    },
    "launchAtLogin": {
      "type": "boolean"
    },
    "hideDock": {
      "type": "boolean"
    },
    "globalShortcut": {
      "type": "string"
    },
    "themeMode": {
      "default": "night",
      "type": "string",
      "enum": [
        "day",
        "night",
        "auto"
      ]
    },
    "trayDisplay": {
      "default": "auto",
      "type": "string",
      "enum": [
        "auto",
        "focusMinutes",
        "focusHours",
        "focusBlocks",
        "activeTimer",
        "bedtime",
        "nextTask",
        "countdown"
      ]
    }
  },
  "required": [
    "dataFolder",
    "realData",
    "launchAtLogin",
    "hideDock",
    "globalShortcut",
    "themeMode",
    "trayDisplay"
  ],
  "additionalProperties": false
}
