{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": 1,
      "type": "number",
      "const": 1
    },
    "main": {
      "default": {
        "name": "Personal",
        "color": "#58a6ff",
        "subtasks": {}
      },
      "type": "object",
      "properties": {
        "name": {
          "default": "Personal",
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "color": {
          "default": "#58a6ff",
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "subtasks": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "additionalProperties": {
            "maxItems": 30,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          }
        }
      },
      "required": [
        "name",
        "color",
        "subtasks"
      ],
      "additionalProperties": false
    },
    "spaces": {
      "default": [],
      "maxItems": 12,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "habits": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              },
              "logId": {
                "type": "string",
                "maxLength": 60,
                "pattern": "^[a-zA-Z0-9_]+$"
              },
              "startDate": {
                "type": "string",
                "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
              },
              "endDate": {
                "default": "",
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                  },
                  {
                    "type": "string",
                    "const": ""
                  }
                ]
              },
              "tasks": {
                "minItems": 1,
                "maxItems": 50,
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "archivedTasks": {
                "default": [],
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                }
              },
              "dayCompleteMin": {
                "default": 1,
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "title",
              "logId",
              "startDate",
              "endDate",
              "tasks",
              "archivedTasks",
              "dayCompleteMin"
            ],
            "additionalProperties": false
          },
          "subtasks": {
            "default": {},
            "type": "object",
            "propertyNames": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "additionalProperties": {
              "maxItems": 30,
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 120
              }
            }
          },
          "countdowns": {
            "default": [],
            "maxItems": 12,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9_-]{1,40}$"
                },
                "title": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "startDate": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                },
                "endDate": {
                  "type": "string",
                  "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
              },
              "required": [
                "id",
                "title",
                "startDate",
                "endDate"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "name",
          "color",
          "habits",
          "subtasks",
          "countdowns"
        ],
        "additionalProperties": false
      }
    },
    "focus": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^(?:0|[1-9]\\d*)$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "space": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]{0,39}$"
          },
          "task": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          }
        },
        "required": [
          "space"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "main",
    "spaces",
    "focus"
  ],
  "additionalProperties": false
}
