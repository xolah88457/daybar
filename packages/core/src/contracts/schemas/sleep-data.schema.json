{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "wakes": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1439
      }
    },
    "beds": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 1439
      }
    },
    "plan": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "start": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
            },
            "wake": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439
            },
            "bed": {
              "type": "integer",
              "minimum": 0,
              "maximum": 1439
            }
          },
          "required": [
            "start",
            "wake",
            "bed"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "wakes",
    "beds",
    "plan"
  ],
  "additionalProperties": false
}
